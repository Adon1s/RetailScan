# ── Secrets & browser profiles ─────────────────────────────────────────────
# Playwright persistent profiles contain cookies, saved logins and history.
# NEVER commit these.
*_profile/
.env
.env.*
sshkey.pub

# ── Scraped data & pipeline outputs ────────────────────────────────────────
# Scraper output: {platform}_{category}.csv and product images
/temu_*.csv
/amazon_*.csv
/*_imgs/
/additional_product_images/

# Organizer / matcher / LLM outputs
/*_analysis.json
/*_products_for_analysis.json
/matching_results*.json
/comparison_history_*.json
/llm_review_batch*.json
/llm_processing_*.checkpoint.json
/single_item_matches_*.json
/viability_screening_results*.json

# Caches, logs, backups, uploads
/embedding_cache/
/pipeline_logs/
/backup_*/
/backup_cache_*/
/static/uploads/

# Temporary wrapper scripts generated by MasterPipeline.py
/temp_*.py

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Editors & OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
